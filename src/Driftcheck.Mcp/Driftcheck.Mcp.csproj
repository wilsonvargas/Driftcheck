<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Paquete de herramienta de .NET con tipo McpServer: se corre con `dnx Driftcheck` sin clonar el repo. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>driftcheck</ToolCommandName>
    <PackageId>Driftcheck</PackageId>
    <PackageType>McpServer</PackageType>
    <Version>0.1.1</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon-128.png</PackageIcon>
    <Authors>Wilson Vargas Marín</Authors>
    <Copyright>Copyright (c) 2026 Wilson Vargas Marín</Copyright>
    <Description>Local MCP server that compares a mobile app screen (Android or iOS Simulator) with its Figma design.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/wilsonvargas/Driftcheck</PackageProjectUrl>
    <RepositoryUrl>https://github.com/wilsonvargas/Driftcheck.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>mcp;mcp-server;figma;android;ios;maui;visual-testing</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="SkiaSharp" Version="4.152.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Comparison\ReportTemplate.html" LogicalName="Driftcheck.Mcp.Comparison.ReportTemplate.html" />
    <!-- PNG del ícono para los clientes que no aceptan SVG (VS Code). -->
    <EmbeddedResource Include="..\..\assets\icon-128.png" LogicalName="Driftcheck.Mcp.icon-128.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- README corto para NuGet.org, que no muestra el HTML del README del repo. -->
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon-128.png" Pack="true" PackagePath="\" />
    <!-- Lo lee el registro de MCP para saber cómo arrancar el servidor. -->
    <None Include=".mcp\server.json" Pack="true" PackagePath="\.mcp\" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI test que vuelca el árbol de accesibilidad del simulador de iOS; SimulatorClient lo compila la primera vez. -->
    <None Include="..\..\tools\ios-accessibility-helper\**" Exclude="..\..\tools\ios-accessibility-helper\**\xcuserdata\**" LinkBase="ios-accessibility-helper" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
